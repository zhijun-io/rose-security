<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>dev.authstarter</groupId>
    <artifactId>auth-security-spring-boot-starter-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Auth Security Spring Boot Starter Parent</name>
    <description>Reusable authentication, MFA, OAuth2/OIDC client login and token sessions for Spring Boot APIs.
    </description>

    <modules>
        <module>auth-security-spring-boot-starter-bom</module>
        <module>auth-security-core</module>
        <module>auth-security-spring-boot-autoconfigure</module>
        <module>auth-security-spring-boot-starter</module>
        <module>auth-security-sample</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <auth-security.version>${project.version}</auth-security.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.authstarter</groupId>
                <artifactId>auth-security-core</artifactId>
                <version>${auth-security.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.authstarter</groupId>
                <artifactId>auth-security-spring-boot-autoconfigure</artifactId>
                <version>${auth-security.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.authstarter</groupId>
                <artifactId>auth-security-spring-boot-starter</artifactId>
                <version>${auth-security.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>3.10.4</version>
                    <configuration>
                        <java>
                            <importOrder/>
                            <removeUnusedImports/>
                            <formatAnnotations/>
                            <palantirJavaFormat>
                                <version>2.102.0</version>
                            </palantirJavaFormat>
                        </java>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
